# Copy to .env and fill in. NEVER commit .env.
LLM_API_KEY=
# Groq (OpenAI-compatible). For xAI Grok use https://api.x.ai/v1 instead.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Model IDs change. Check your provider console and update if needed.
LLM_MODEL=llama-3.3-70b-versatile
# Optional speech-to-text. Defaults to the Groq-compatible API and reuses LLM_API_KEY.
# Set SPEECH_API_KEY only if speech transcription uses a separate provider key.
SPEECH_API_KEY=
SPEECH_BASE_URL=https://api.groq.com/openai/v1
SPEECH_MODEL=whisper-large-v3-turbo
SPEECH_TIMEOUT_SECONDS=30
SPEECH_MAX_AUDIO_MB=10
SPEECH_MAX_DURATION_SECONDS=120
SPEECH_LANGUAGE=en
DB_PATH=resolveai.db
DUP_THRESHOLD=45
LLM_TIMEOUT_SECONDS=20
# Campus Intelligence agent limits (hard-capped by the application)
AGENT_MAX_TURNS=4
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_TOOL_CALLS_PER_TURN=3
AGENT_MAX_HISTORY_MESSAGES=8
AGENT_TIMEOUT_SECONDS=30
# First staff account, created on startup ONLY if no staff exists yet. Remove both after first sign-in.
STAFF_EMAIL=
STAFF_PASSWORD=
# Optional: only these email domains may self-register as students (comma separated). Empty = anyone.
ALLOWED_EMAIL_DOMAINS=
# Set to 1 only for a private local demo to create published one-touch demo accounts.
DEMO_MODE=0
# Service-level targets in hours, by priority (staff see time left / overdue)
SLA_HIGH_HOURS=8
SLA_MEDIUM_HOURS=48
SLA_LOW_HOURS=120
# Explicit hazard reports are routed to Campus Safety & Emergency Response.
SLA_CRITICAL_MINUTES=30
# Optional email alerts to non-demo safety responders and all-department staff admins.
# Use an SMTP app password/relay credential; never commit real values to this file.
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_SMTP_TIMEOUT=10

# Worker phone defaults to the number entered by the project owner for SMS alerts.
DEFAULT_WORKER_PHONE=+916398758826

# Optional Twilio SMS alerts for critical safety tickets. Store real credentials only in local .env or deployment secrets.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set either a Messaging Service SID or a Twilio sender phone number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_PHONE=
ALERT_SMS_TIMEOUT=8
# Protects the AI budget and the queue: per student
RATE_ANALYSES_PER_HOUR=12
RATE_REPORTS_PER_DAY=15
LOG_LEVEL=INFO
